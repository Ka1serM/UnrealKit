schema_version = "1.0.0"

id = "unrealkit"
version = "@UNREALKIT_VERSION@"
name = "UnrealKit"
tagline = "Receive scenes from UnrealKit apps"
maintainer = "Marcel K."
type = "add-on"
license = ["SPDX:GPL-3.0-or-later"]
blender_version_min = "4.5.0"
tags = ["Import-Export"]
wheels = ["./wheels/@FLATBUFFERS_WHEEL@"]

[permissions]
network = "Listen on 127.0.0.1:@UNREALKIT_BLENDER_PORT@ for scenes from UnrealKit apps"
